     /**
      * \brief Get record format length
      *
      * Returns the record format length of the passed file from the
      * first format (which should be enough as source files only
      * have one format).
      *
      * \param Library name
      * \param File name
      *
      * \return Record format length
      *
      * \author Mihael Schmidt
      */
     P getRecordFormatLength...
     P                 B                   export
     D                 PI            10I 0
     D   library                     10A   const
     D   file                        10A   const
      *
     D usLib           S             10A
     D usName          S             10A
     D usPtr           S               *
     D usData          DS                  likeds(tmpl_userspace_header)
     D                                     based(usPtr)
     D lenOffset       S             10I 0 inz(24)
     D usDataPtr       S               *
     D recordLength    S             10I 0 based(usDataPtr)
     D retVal          S             10I 0
      /free
       clear QUSEC;
       QUSBPRV = 0;

       //RN02 - Fail if library and member were not passed
       if library = '' or file = '';
         return 0;
       endif;

       // get userspace
       usPtr = getNewUserspace(usLib : usName);

       // get record formats
       api_listRecordFormats(usName + usLib :
                             'RCDL0200' :
                             file + library :
                             '0' :
                             QUSEC);

       usDataPtr = usPtr + usData.offsetList + lenOffset;
       retVal = recordLength - 12;

       return retVal;
      /end-free
     P                 E


     /**
      * \brief Get new userspace
      *
      * Creates a new userspace, initializes it and sets the auto
      * extend capabilities on it.
      *
      * \return Pointer to the new userspace
      */
     P getNewUserspace...
     P                 B                   export
     D                 PI              *
     D   pUsLib                      10A   options(*nopass)
     D   pUsName                     10A   options(*nopass)
      *
     D usLib           S             10A
     D usName          S             10A
     D usPtr           S               *
     D usAttr          DS                  likeds(tmpl_userspace_attributes)
      /free
       clear QUSEC;
       QUSBPRV = 0;

       usLib = 'QTEMP';
       usName = %subst(%str(tmpnam(*omit)) : 7);

       userspace_create(
           usName + usLib : *blank : 4096 : X'00' : '*ALL' : 'ILEDocs' :
           '*YES' : QUSEC );

       // make userspace autoextend
       usAttr.size = 1;  // 1 attribute will be changed
       usAttr.key = 3;   // 3=extensibility attribute
       usAttr.dataLength = 1;
       usAttr.data = '1'; // user space is extensible
       userspace_changeAttributes(usLib : usName + usLib : usAttr : QUSEC);

       userspace_retrievePointer(usName + usLib : usPtr : QUSEC);

       if (%parms() >= 1);
         pUsLib = usLib;
       endif;

       if (%parms() = 2);
         pUsName = usName;
       endif;

       return usPtr;
      /end-free
     P                 E


     /**
      * \brief Check String for beginning char sequence
      *
      * Checks if a string starts with a string pattern.
      * Blanks on the search pattern are trimmed.
      *
      * \param Source string
      * \param Source string size
      * \param Search pattern
      * \param Search pattern size
      *
      * \return *on = source string starts with pattern <br>
      *         *off = source string doesn't start with pattern
      *
      * \author Mihael Schmidt
      */
     P startsWith      B                   export
     D                 PI              N
     D   source                     100A   const options(*varsize)
     D   sourceSize                  10I 0 const
     D   pattern                    100A   const options(*varsize)
     D   patternSize                 10I 0 const
      *
      /free
         if (sourceSize < patternSize);
           return *off;
         elseif (%len(%trim(source)) = 0);
           return *off;
         elseif (%subst(%trim(source) : 1 : patternSize) =
                 %subst(pattern : 1 : patternSize));
           return *on;
         else;
           return *off;
         endif;
      /end-free
     P                 E

     /**
      * \brief Check string for ending char sequence
      *
      * Checks if the given string ends with the
      * passed pattern.
      *
      * \param Source string
      * \param Source string size
      * \param Search pattern
      * \param Search pattern size
      *
      * \return *on = source string ends with pattern <br>
      *         *off = source string doesn't end with pattern
      *
      * \author Mihael Schmidt
      */
     P endsWith        B                   export
     D                 PI              N
     D   source                     100A   const options(*varsize)
     D   sourceSize                  10I 0 const
     D   pattern                    100A   const options(*varsize)
     D   patternSize                 10I 0 const

      /free
         if (sourceSize < patternSize);
           return *off;
         elseif (%len(%trim(source)) = 0);
           return *off;
         elseif (%subst(%trim(source) : sourceSize - patternSize + 1 :
                 patternSize) = %subst(pattern : 1 : patternSize));
           return *on;
         else;
           return *off;
         endif;
      /end-free
     P                 E


     /**
      * \brief Resolve QSYS path
      *
      * Resolves the given Parameter into a QSYS path. The resolved
      * path has the syntax: Library/File,Member.
      * <br><br>
      * The parameter can be composed of the full path or only parts
      * of the QSYS path.
      *
      * \author Mihael Schmidt
      *
      * \param Path
      * \param Default file name (default: QRPGLESRC)
      *
      * \return Resolved path
      */
     P resolveQsysPath...
     P                 B                   export
     D                 PI            32A
     D  pPath                        32A   const
     D  defaultFile                  10A   const options(*nopass)
      *
     D tmp             S             32A
     D library         S             10A   inz('*LIBL')
     D file            S             10A   inz('QRPGLESRC')
     D member          S             10A
      *
     D entries         S             10I 0
      *
     D libraries       S               *
     D ptr             S               *
     D lib             S             10A
     D members         S               *
      /free
       if (%parms() = 2);
         file = defaultFile;
       endif;

       clear QUSEC;
       QUSBPRV = 0;

       caseConvert(requestControlBlockUpper : pPath :
                   tmp : %len(pPath) : QUSEC);

       // possible valid entries:
       // library/file,member
       // file,member
       // member

       if (%scan('/' : tmp) > 0);
         library = %subst(tmp : 1 : %scan('/' : tmp) - 1);
         tmp = %subst(tmp : %scan('/' : tmp) + 1);
       endif;

       if (%scan(',' : tmp) > 0);
         file = %subst(tmp : 1 : %scan(',' : tmp) - 1);
         tmp = %subst(tmp : %scan(',' : tmp) + 1);
       endif;

       member = tmp;

       // iterate through either the stated library or through the whole library list
       if (library = '*LIBL');
         libraries = lutil_listJobLibraryList();
       else;
         libraries = list_create();
         list_add(libraries : %addr(library) : %size(library));
       endif;

       // search the copybook in the previously determined libraries
       ptr = list_getNext(libraries);
       dow (ptr <> *null);
         lib = %str(ptr);

         monitor;
           members = lutil_listFileMembers(lib : file);
           on-error *all;
         endmon;

         if (members = *null);
           // file not in lib
         elseif (list_contains(members : %addr(member) : %len(%trimr(member))));
           library = lib;
           leave;
         endif;

         if (members <> *null);
           list_dispose(members);
         endif;

         ptr = list_getNext(libraries);
       enddo;

       if (libraries <> *null);
         list_dispose(libraries);
       endif;

       return %trimr(library) + '/' + %trimr(file) + ',' + %trimr(member);
      /end-free
     P                 E


     /**
      * \brief Split QSYS path
      *
      * Splits a full QSYS path into its components.
      * SCHMIDTM/QRPGLESRC,XMLRPC => [SCHMIDTM, QRPGLESRC, XMLRPC].
      *
      * \author Mihael Schmidt
      * \date 24.08.2009
      *
      * \param full QSYS path
      *
      * \return QSYS path data structure
      */
     P splitQsysPath   B                   export
     D                 PI                  likeds(tmpl_qsysPath)
     D   pPath                       32A   const
      *
     D path            S             32A
     D qsysPath        DS                  likeds(tmpl_qsysPath)
      /free
       path = pPath;

       if (%scan('/' : path) > 0);
         qsysPath.library = %subst(path : 1 : %scan('/' : path) - 1);
         path = %subst(path : %scan('/' : path) + 1);
       endif;

       if (%scan(',' : path) > 0);
         qsysPath.object = %subst(path : 1 : %scan(',' : path) - 1);
         path = %subst(path : %scan(',' : path) + 1);
       endif;

       qsysPath.member = path;

       return qsysPath;
      /end-free
     P                 E



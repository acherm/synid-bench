     /**
      * \brief Choose parser
      *
      * A pointer to the parser procedure will be returned. The
      * parser procedure will be determined by the source type
      * (attribute).
      *
      * <br><br>
      *
      * Sourcetypes for RPG parser:
      * <ul>
      *  <li>RPG</li>
      *  <li>RPGLE</li>
      *  <li>SQLRPGLE</li>
      * </ul>
      *
      * <br>
      *
      * Sourcetypes for CL parser:
      * <ul>
      *  <li>CL</li>
      *  <li>CLP</li>
      *  <li>CLLE</li>
      *  <li>CLP38</li>
      * </ul>
      *
      * \param Pointer to parser procedure
      * \param Source library
      * \param Source file
      * \param Source member
      *
      * \return 1 = successful <br>
      *         0 = error
      */
     P getParseProc    B                   export
     D                 PI            10I 0
     D   procPointer                   *   procptr
     D   library                     10A   const
     D   filename                    10A   const
     D   member                      10A   const
      *
     D retVal          S             10I 0
     D clTypes         S             10A   DIM(4)
     D rpgTypes        S             10A   DIM(3)
     D sourceType      S             10A
     D receiver        S           1024A
      *
      *
      /free
       clear QUSEC;
       QUSBPRV = 0;

       // assign types to the parsers
       clTypes(1) = 'CLLE';
       clTypes(2) = 'CLP';
       clTypes(3) = 'CLP38';
       clTypes(4) = 'CL';

       rpgTypes(1) = 'RPGLE';
       rpgTypes(2) = 'SQLRPGLE';
       rpgTypes(3) = 'RPG';

       // get program type (RPG, RPGLE, SQLRPGLE, ...)
       api_retrieveMemberDescription(receiver :
                                     %len(receiver) :
                                     'MBRD0100' :
                                     filename + library :
                                     member :
                                     '0' :
                                     QUSEC);
       sourceType = %subst(receiver : 49 : 10);

       // determine the parse procedure
       select;
         when (%lookup(sourceType : clTypes) > 0);
           procPointer = %paddr('PARSECL');
           retVal = 1;

         when (%lookup(sourceType : rpgTypes) > 0);
           procPointer = %paddr('PARSERPG');
           retVal = 1;

         other;
           retVal = 0;

       endsl;

       return retVal;
      /end-free
     P                 E



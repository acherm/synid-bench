     /**
      * \brief Load Configurations
      *
      * The configuration data will be loaded from the file ILEDCONF.
      * This file has a member for every language. If a language does
      * not have its own member the default member will be used which
      * contains the english configuration. The language will be
      * retrieved from the system value QCNTRYID.
      *
      * \param Pointer to config data structure
      */
     P loadConfig      B                   export
     D                 PI
     D   pConfig                       *   const
      *
     D cfg             DS                  likeds(config) based(pConfig)
      *
     D receiverDs      DS
     D   receiver                   100A
     D   numberSysVal                10I 0 overlay(receiver)
     D   offset                      10I 0 overlay(receiver : *next)
      *
     D countryID       S              2A
     D conf_key        S             50A   varying
      /free
       clear QUSEC;
       QUSBPRV = 0;

       api_retrieveSystemValue(receiver : 100 : 1 : 'QCNTRYID' : QUSEC);
       countryID = %subst(receiver : offset + 17 : 2);
       confMember = countryID;

       open(e) ILEDCONF;
       if (%error);
         confMember = 'DEFAULT';
         open(e) ILEDCONF;
       endif;

       if (%open(ILEDCONF));
         read ILEDCONF;
         dow (not %eof);
           %len(conf_key) = 0;
           conf_key = %trim(CONFKEY);

           select;
             when (conf_key = 'doc_start');
               cfg.doc_start = CONFVALUE;

             when (conf_key = 'doc_middle');
               cfg.doc_middle = CONFVALUE;

             when (conf_key = 'doc_end');
               cfg.doc_end = CONFVALUE;

             when (conf_key = 'tag_program');
               cfg.tag_program = CONFVALUE;

             when (conf_key = 'tag_brief');
               cfg.tag_brief = CONFVALUE;

             when (conf_key = 'tag_category');
               cfg.tag_category = CONFVALUE;


     /**
      * \brief Remove unprintable characters
      *
      * Replaces all unprintable characters with a blank.
      *
      * \param string
      *
      * \return purged string
      */
     P removeUnprintableCharacters...
     P                 B                   export
     D                 PI           100A
     D   string                     100A   const
      *
     D purgedString    S            100A
     D ptr             S               *   inz(%addr(purgedString))
     D character       S              1A   based(ptr)
     D i               S             10I 0
      /free
       purgedString = string;

       for i = 1 to %size(string);
         if (character < x'40' or
             character = x'FF');
           %subst(purgedString : i : 1) = ' ';
         endif;

         ptr += 1;
       endfor;

       return purgedString;
      /end-free
     P                 E

     DNode             DS                  LikeDs(CTLST_Node) Based(NodePtr)
      /Free
           If (Header.Count > 0);
             NodePtr = Header.Current;
             If (Node.Next <> *null);
                Header.Current = Node.Next;
                Header.CurIndex = Header.CurIndex + 1;
                Return CS_SUCCESS;
             EndIf;
           EndIf;

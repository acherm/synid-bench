      *-----------------------------------------------------------------------------

     PCSAPCLIENT_ReadData...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value
     D@Buffer                          *   Value
     D@Size                          10I 0 Value

     D#Instance        DS                  LikeDs(CSAPCLIENT_Instance)
     D                                     Based(@This)
     D#hresult         S             10I 0

      /Free

         If @Size <= 0;
           #hResult = CSAP_SUCCESS;
         EndIf;

         #hResult = CSAP_FAILURE;
         If (#Instance.ResponseFrameOffset < #Instance.ResponseFrameSize);
           If (@Size <=
               #Instance.ResponseFrameSize - #Instance.ResponseFrameOffset);
             #hResult = CSAP_SUCCESS;
             CSAP_PRIVATE_MemCpy(@Buffer:
                                 #Instance.pResponseFrame
                                       + #Instance.ResponseFrameOffset:
                                 @Size);

             #Instance.ResponseFrameOffset += @Size;

           EndIf;
         EndIf;

         Return #hResult;

      /End-Free

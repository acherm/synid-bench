          EndIf;

          CTLST_PRIVATE_Goto(@This: @Index);

          Rc = CS_FAILURE;
          If ( Header.Current <> *Null );
             NodePtr = Header.Current;
             @ItemRef = Node.Value;
             @Bytes = Node.Bytes;
             Rc = CS_SUCCESS;
          Else;
            @Bytes = -1;

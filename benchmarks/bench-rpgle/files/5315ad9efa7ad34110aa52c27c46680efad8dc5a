     PCSAPSERVER_CloseChannel...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value

     D#Instance        DS                  LikeDs(CSAPSERVER_Instance)
     D                                     Based(@This)

      /Free

          If (#Instance.pCONN <> *Null);

              If #Instance.Secure = 1;
                CSAPCORE_Close(#Instance.pCONN);
              Else;
                CSAPCORE_SecureClose(#Instance.pCONN);
              EndIf;

              #Instance.pCONN = *Null;

          EndIf;

          Return CSAP_SUCCESS;

      /End-Free


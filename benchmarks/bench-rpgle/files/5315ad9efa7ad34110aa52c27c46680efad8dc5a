     D#hresult         S             10I 0
     D#Name            S             66A

      /Free
            #Name = '/' + %Trim(@LockName) + x'00';

            #Instance.Lock = CSAP_PRIVATE_sem_open(%Addr(#Name):
                                                   O_CREAT:
                                                   448 + 56 + 7:
                                                   1);

            If (#Instance.Lock = *Null);
              Return CSAP_FAILURE;
            EndIf;

            #hresult = CSAP_PRIVATE_sem_wait(#Instance.Lock);
            If (#hResult < 0);
              CSAP_PRIVATE_sem_close(#Instance.Lock);
              CSAP_PRIVATE_sem_unlink(#Instance.LockName);
            EndIf;

            Return CSAP_SUCCESS;

      /End-Free


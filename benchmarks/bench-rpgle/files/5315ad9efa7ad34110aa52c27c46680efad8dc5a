     PCSAPSERVER_Destructor...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *

     D#Instance        DS                  LikeDs(CSAPSERVER_Instance)
     D                                     Based(@This)

      /Free

          If (@This <> *Null);

            If (#Instance.pDataFrame <> *Null);
              Dealloc #Instance.pDataFrame;
            EndIf;

            If (#Instance.pLastError <> *Null);
              Dealloc #Instance.pLastError;
            EndIf;

            If (#Instance.Lock <> *Null);
              //CSAP_PRIVATE_sem_close(#Instance.Lock);
              //CSAP_PRIVATE_sem_unlink(#Instance.LockName);
            EndIf;

            CTLST_Destructor(#Instance.pResponseDataFrame);

            Dealloc @This;
            @This = *Null;
          EndIf;

          Return CSAP_SUCCESS;

      /End-Free

     P                 E


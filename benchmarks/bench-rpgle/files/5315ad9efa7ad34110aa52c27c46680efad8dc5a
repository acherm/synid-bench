     PCSAPSERVER_Constructor...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *

     D#Instance        DS                  LikeDs(CSAPSERVER_Instance)
     D                                     Based(@This)

      /Free

          @This = %Alloc(%Size(CSAPSERVER_Instance));

          CSAP_PRIVATE_MemSet(@This: 0:
                              %Size(CSAPSERVER_Instance));

          #Instance.pDataFrame = *Null;
          #Instance.ConnectionHandle = -1;
          #Instance.DataFrameOffset = 0;
          #Instance.Lock = *Null;

          CSAP_PRIVATE_MemSet(%Addr(#Instance.LockName): 0:
                              %Size(#Instance.LockName));

          #Instance.pResponseDataFrame = CTLST_Constructor();

          #Instance.pLastError = %Alloc(%Size(CSAP_Result));

          CSAP_PRIVATE_MemSet(#Instance.pLastError: 0:
                              %Size(CSAP_Result));

          Return CSAP_SUCCESS;

      /End-Free

     P                 E


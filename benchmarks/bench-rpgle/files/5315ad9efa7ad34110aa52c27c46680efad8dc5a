     PCSAPSERVER_GetConfig...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value
     D@Param                         64A   Value
     D@Values                          *   Value

     D#Rc              S             10I 0
     D#Result          DS                  LikeDS(CSAP_Result)
     D#Instance        DS                  LikeDs(CSAPSERVER_Instance)
     D                                     Based(@This)
     D#Value           S             64A

      /Free
        #Rc = CSAP_SUCCESS;

        Monitor;
          CTLST_Clear(@Values);
          Exec SQL Declare C_SRVCONF Cursor For
             select CFG001VAL FROM SRVCONF
                  WHERE CFG001PARM = :@Param
                        AND CFG001SRVN = :#Instance.ServiceName
                        AND CFG001SRVI = :#Instance.ServiceID
                   ORDER BY CFG001SEQ;

          Exec SQL Open C_SRVCONF;
          If SqlCode = 0;
            Exec SQL Fetch C_SRVCONF into :#Value;
            Dow SqlCode = 0;
              CTLST_Insert(@Values: %Addr(#Value):
                                %Size(#Value): CTLST_BOTTOM);
              Exec SQL Fetch C_SRVCONF into :#Value;
            EndDo;
            Exec SQL Close C_SRVCONF;
          EndIf;
        On-Error;
          Exec SQL Close C_SRVCONF;
          #Rc = CSAP_FAILURE;
        EndMon;

        Return #Rc;
      /End-Free


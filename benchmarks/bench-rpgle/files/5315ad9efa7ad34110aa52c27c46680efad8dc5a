     PCSAPSERVER_SetLLData...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value
     D@Limit                         10I 0 Value

     D#Instance        DS                  LikeDs(CSAPSERVER_Instance)
     D                                     Based(@This)
     D#hresult         S             10I 0

      /Free

       #hResult = CSAP_FAILURE;
       If @Limit < 0;
         @Limit = 1;
       EndIf;

       If (@Limit < #Instance.DataFrameSize);
         #hResult = CSAP_SUCCESS;
         #Instance.DataFrameOffset = @Limit;
       Else;
         #Instance.DataFrameOffset = #Instance.DataFrameSize;
       EndIf;

       Return #hResult;

      /End-Free


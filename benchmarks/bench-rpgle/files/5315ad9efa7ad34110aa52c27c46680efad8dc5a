     PCSAPSERVER_OpenChannel...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value
     D@ServiceName                   64A   Value
     D@ServiceID                     32A   Value
     D@SessionID                     32A   Value
     D@ConnectionHandle...
     D                                5I 0 Value

     D#Instance        DS                  LikeDs(CSAPSERVER_Instance)
     D                                     Based(@This)
     D#Values          S               *
     D#Value           S             64A
     D#ValueSize       S             10I 0

      /Free
          #Values = CTLST_Constructor();

          #Instance.pCONN = CSAPCONN_E;

          If SEC_E = 1;
            #Instance.Secure = 1;
          Else;
            #Instance.Secure = 0;
          EndIf;

          Monitor;

          #Instance.ServiceName = @ServiceName;
          #Instance.ServiceID = @ServiceID;
          #Instance.SessionID = @SessionID;
          #Instance.Version   = CSAP_VERSION;
          #Instance.ConnectionHandle = @ConnectionHandle;
          CSAPSERVER_GetConfig(@This: '*LOG': #Values);
          #Instance.Log = *Off;
          If CTLST_Count(#Values) > 0;
            CTLST_Get(#Values: %Addr(#Value): #ValueSize: CTLST_TOP);
            If (%Trim(#Value) = 'YES' Or %Trim(#Value) = 'yes');
              #Instance.Log = *On;
            EndIf;
          EndIf;
          On-Error;

          EndMon;
          CTLST_Destructor(#Values);
          Return CSAP_SUCCESS;

      /End-Free

     P                 E


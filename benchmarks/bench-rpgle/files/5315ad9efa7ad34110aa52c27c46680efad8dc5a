     PCSAPSERVER_RecvFrame...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value
     D@CtlFrame                            LikeDS(CSAP_CtlFrame)

     D#Instance        DS                  LikeDs(CSAPSERVER_Instance)
     D                                     Based(@This)

     D#LastError       DS                  LikeDs(CSAP_Result)
     D                                     Based(#Instance.pLastError)

     D#hresult         S             10I 0
     D#Bytes           S             10I 0
     D#Size            S             10I 0
     D#DataSize        S             20U 0
     D#Rc              S             10U 0
     D#SSLResult       S             10I 0
     D#CtlFrameA       DS                  LikeDS(CSAP_T_CtlFrame)

      /Free

         #hResult = CSAP_FAILURE;
         CSAP_PRIVATE_MemSet(#Instance.pLastError: 0:
                             %Size(CSAP_Result));

         #DataSize = %Size(CSAP_T_CtlFrame);

         If #Instance.Secure = 1;

           #Rc = CSAPCORE_SecureReadRecord(#Instance.pCONN:
                                      %Addr(#CtlFrameA):
                                      %Addr(#DataSize):
                                      -1: %Addr(#SSLResult));
         Else;

           #Rc = CSAPCORE_ReadRecord(#Instance.pCONN:
                                %Addr(#CtlFrameA):
                                %Addr(#DataSize):
                                -1);
         EndIf;

         If %bitand(#Rc: CS_MASK_ERROR) = CS_SUCCESS;

           AsciiToEbcdic(#CtlFrameA: #Size);

           @CtlFrame.CtlCode       = #CtlFrameA.CtlCode;
           @CtlFrame.UserRef       = #CtlFrameA.UserRef;
           @CtlFrame.DataEncoding  = %Int(%Trim(#CtlFrameA.DataEncoding));

           If (#CtlFrameA.DataFrameSize <> *Blanks);
             @CtlFrame.DataFrameSize = %Int(%Trim(#CtlFrameA.DataFrameSize));
           Else;
             @CtlFrame.DataFrameSize = 0;
           EndIf;

           If (#CtlFrameA.UserCtlSize <> *Blanks);
             @CtlFrame.UserCtlSize = %Int(%Trim(#CtlFrameA.UserCtlSize));
           Else;
             @CtlFrame.UserCtlSize = 0;
           EndIf;

           #Instance.DataFrameSize = @CtlFrame.DataFrameSize;

           If (@CtlFrame.DataFrameSize > 0);

             // Read the Data

             If (#Instance.pDataFrame <> *Null);
               Dealloc #Instance.pDataFrame;
               #Instance.DataFrameOffset = 0;
             EndIf;

             #Instance.pDataFrame = %Alloc(@CtlFrame.DataFrameSize);

             If #Instance.pDataFrame <> *Null;

               #DataSize =#Instance.DataFrameSize;

               If #Instance.Secure = 1;

                 #Rc = CSAPCORE_SecureReadRecord(#Instance.pCONN:
                                            #Instance.pDataFrame:
                                            %Addr(#DataSize):
                                            -1: %Addr(#SSLResult));
               Else;

                 #Rc = CSAPCORE_ReadRecord(#Instance.pCONN:
                                      #Instance.pDataFrame:
                                      %Addr(#DataSize):
                                      -1);
               EndIf;

               @CtlFrame.BytesAvail = #Bytes;
               #Instance.BytesAvail = #Bytes;

               If %bitand(#Rc: CS_MASK_ERROR) = CS_SUCCESS;
                 #hResult = CSAP_SUCCESS;
                 #LastError.Status = '200';
                 #LastError.Reason = CSAP_OK;
               Else;
                 // Could not read all data
                 // Low-order Reason is given by ReadChannel
                 #LastError.Status = '601';
                 #LastError.Reason = CSAP_RECV +
                                     CSAP_USRDATASEGMENT +
                                     %Trim(#LastError.Reason);
                 #hResult = CSAP_FAILURE;
               EndIf;
             Else;
               // Could not allocate buffer to read data
               @CtlFrame.BytesAvail = 0;
               #Instance.BytesAvail = 0;
               #LastError.Status = '601';
               #LastError.Reason = CSAP_RECV +
                                   CSAP_USRDATASEGMENT +
                                   CSAP_BUFFERERROR;
               #hResult = CSAP_FAILURE;
             EndIf;
           Else;
             // Client sent no data
             #hResult = CSAP_SUCCESS;
             #LastError.Status = '200';
             #LastError.Reason = CSAP_OK;
             @CtlFrame.BytesAvail = 0;
             #Instance.BytesAvail = 0;
           EndIf;
         Else;
           // Could not read entire control frame
           #hResult = CSAP_FAILURE;
           #LastError.Status = '601';
           #LastError.Reason = CSAP_RECV +
                               CSAP_CTLSEGMENT +
                               %Trim(#LastError.Reason);

           CSAP_PRIVATE_MemSet(%Addr(@CtlFrame): 0: %Size(@CtlFrame));
         EndIf;

         Return #hResult;

      /End-Free

     P                 E


     PCSAPCLIENT_OpenService...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value
     D@ServiceName                   64A   Value
     D@SessionInfo                         LikeDS(CSAP_Session)

     D#Instance        DS                  LikeDs(CSAPCLIENT_Instance)
     D                                     Based(@This)

     D#LastError       DS                  LikeDs(CSAP_Result)
     D                                     Based(#Instance.pLastError)

     D#Rc              S             10U 0
     D#Flags           S             10I 0
     D#hResult         S             10I 0
     D#Bytes           S             10I 0
     D#Size            S             10I 0
     D#SSLResult       S             10I 0
     D#DataSize        S             20U 0
     D#HostBuffer      S            256A
     D#AppID           S             32A
     D#Handshake       DS                  LikeDS(CSAP_Handshake)
     D#Req             S              3A   Inz('EXC')
     D#SessionInfo     DS                  LikeDS(CLIENTSESSIONINFO_100)
     D#ServiceName     S             64A

      /Free

          If (#Instance.pCONN <> *Null);

              If #Instance.Secure = 1;
                CSAPCORE_Close(#Instance.pCONN);
              Else;
                CSAPCORE_SecureClose(#Instance.pCONN);
              EndIf;

          EndIf;

          CSAP_PRIVATE_MemSet(#Instance.pLastError: 0: %Size(CSAP_Result));

          #Instance.Version = *Blanks;
          #Instance.SessionID = *Blanks;
          #Instance.ServiceName = @ServiceName;

          #hResult = CSAP_FAILURE;
          Chain(n) (@ServiceName) CSAPCDIR;

          If %Found();

            // Lire le vrai nom de service
            @ServiceName = DIR001SERV;
            #HostBuffer = %Trim(DIR001HOST) + x'00';
            #Instance.#Port = DIR001PORT;

            Select;

              When DIRX01SCMD = '*SSL';

                #Instance.Secure = 1;
                #AppID = %Trim(DIRX01PID) + x'00';
                #SessionInfo
                   .pszBuffers(CSAPCORE_OFFSET_GSK_OS400_APPLICATION_ID)
                                       = %Addr(#AppID);

              When DIRX01SCMD = '*NOSEC';

                #Instance.Secure = 0;

            EndSl;

            #SessionInfo.szHostName = %Addr(#HostBuffer);
            #SessionInfo.port = %Int(DIR001PORT);

            If #Instance.Secure = 1;

              #Instance.pCONN = CSAPCORE_SecureConnect(%Addr(#SessionInfo):
                                              CSAPCORE_CLIENTSESSION_FMT_100:
                                                  %Addr(#SSLResult));

            Else;

              #Instance.pCONN = CSAPCORE_Connect(%Addr(#SessionInfo):
                                            CSAPCORE_CLIENTSESSION_FMT_100);

            EndIf;

            If #Instance.pCONN <> *Null;

              EbcdicToAscii(@ServiceName: 64);
              #ServiceName = @ServiceName;
              #DataSize = 64;

              If #Instance.Secure = 1;

                #Rc = CSAPCORE_SecureWriteRecord(#Instance.pCONN:
                                            %Addr(#ServiceName):
                                            %Addr(#DataSize):
                                            -1: %Addr(#SSLResult));
              Else;

                #Rc = CSAPCORE_WriteRecord(#Instance.pCONN:
                                      %Addr(#ServiceName):
                                      %Addr(#DataSize):
                                      -1);
              EndIf;

              If %bitand(#Rc: CS_MASK_ERROR) = CS_SUCCESS;

                #DataSize = %Size(CSAP_Handshake);

                If #Instance.Secure = 1;

                  #Rc = CSAPCORE_SecureReadRecord(#Instance.pCONN:
                                             %Addr(#Handshake):
                                             %Addr(#DataSize):
                                             -1: %Addr(#SSLResult));
                Else;

                  #Rc = CSAPCORE_ReadRecord(#Instance.pCONN:
                                       %Addr(#Handshake):
                                       %Addr(#DataSize):
                                       -1);
                EndIf;

                If %bitand(#Rc: CS_MASK_ERROR) = CS_SUCCESS;

                  #Size = #DataSize;

                  // Convert response to EBCDIC
                  AsciiToEbcdic(#Handshake: #Size);

                  #LastError.Status = #Handshake.Status;
                  #LastError.Reason = #Handshake.Reason;

                  Select;
                    When #Handshake.Status = '110';
                      #LastError.Status = '110';
                      #hResult = CSAP_FAILURE;
                    When #Handshake.Status = '120';
                      #LastError.Status = '120';
                      #hResult = CSAP_FAILURE;
                    When #Handshake.Status = '130';
                      #LastError.Status = '130';
                      #hResult = CSAP_FAILURE;
                    When #Handshake.Status = '200';
                      #LastError.Status = '200';
                      #LastError.Reason = CSAP_OK;
                      #hResult = CSAP_SUCCESS;
                  EndSl;

                  #Instance.Version = #Handshake.Version;
                  #Instance.SessionID = #Handshake.SessionID;

                  @SessionInfo.Version = #Handshake.Version;
                  @SessionInfo.SessionID = #Handshake.SessionID;

                Else;

                  // Could not read all required data
                  #LastError.Status = '101';
                  #LastError.Reason = CSAP_OPEN +
                                      CSAP_CLIENT +
                                      #LastError.Reason;

                EndIf;

              Else;

                // Could not send all required data
                #LastError.Status = '101';
                #LastError.Reason = CSAP_OPEN +
                                    CSAP_CLIENT +
                                    #LastError.Reason;
              EndIf;

            EndIf;

          Else;

            // Service not found
            #LastError.Status = '101';
            #LastError.Reason = CSAP_OPEN +
                                CSAP_CLIENT +
                                CSAP_SRVNOTFOUND;

          EndIf;

          Return #hResult;

      /End-Free

     P                 E


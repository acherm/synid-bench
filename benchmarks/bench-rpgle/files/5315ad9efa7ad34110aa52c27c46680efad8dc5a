     PCSAPCLIENT_SendFrame...
     P                 B                   EXPORT
     D                 PI            10I 0
     D@This                            *   Value
     D@UserCtl                         *   Value
     D@Size                          10I 0 Value
     D@UserRef                       32A   Value
     D@CCSID                          5I 0 Value

     D#Instance        DS                  LikeDs(CSAPCLIENT_Instance)
     D                                     Based(@This)

     D#LastError       DS                  LikeDs(CSAP_Result)
     D                                     Based(#Instance.pLastError)

     D#hResult         S             10I 0
     D#Rc              S             10U 0
     D#DataSize        S             20U 0
     D#Count           S             10I 0
     D#i               S             10I 0
     D#Size            S             10I 0
     D#FrameSize       S             10I 0
     D#Bytes           S             10I 0
     D#SSLResult       S             10I 0
     D#Data            S               *
     D#CtlFrameA       DS                  LikeDS(CSAP_T_CtlFrame)

      /Free

         #hResult = CSAP_FAILURE;

         // Build the Control Frame

         #CtlFrameA.CtlCode = 'REQ';
         // Generate UUID for system reference
         #CtlFrameA.UserRef = @UserRef;
         #CtlFrameA.DataEncoding = %EditC(@CCSID: 'X');
         #FrameSize = #Instance.DataFrameSize + @Size;
         #CtlFrameA.DataFrameSize = %Char(#FrameSize);
         #CtlFrameA.UserCtlSize = %Char(@Size);

         EbcdicToAscii(#CtlFrameA : %Size(CSAP_T_CtlFrame));

         #DataSize = %Size(CSAP_T_CtlFrame);

         If #Instance.Secure = 1;

           #Rc = CSAPCORE_SecureWriteRecord(#Instance.pCONN:
                                       %Addr(#CtlFrameA):
                                       %Addr(#DataSize):
                                       -1: %Addr(#SSLResult));
         Else;

           #Rc = CSAPCORE_WriteRecord(#Instance.pCONN:
                                 %Addr(#CtlFrameA):
                                 %Addr(#DataSize):
                                 -1);
         EndIf;

         If %bitand(#Rc: CS_MASK_ERROR) = CS_SUCCESS;

           // Send the user control record first (if there is one)

           If (@Size > 0);

             #DataSize = @Size;

             If #Instance.Secure = 1;

               #Rc = CSAPCORE_SecureWriteRecord(#Instance.pCONN:
                                           @UserCtl:
                                           %Addr(#DataSize):
                                           -1: %Addr(#SSLResult));
             Else;

               #Rc = CSAPCORE_WriteRecord(#Instance.pCONN:
                                     @UserCtl:
                                     %Addr(#DataSize):
                                     -1);
             EndIf;
           EndIf;

           If %bitand(#Rc: CS_MASK_ERROR) = CS_SUCCESS;

             // Send the data
             #Count = CTLST_Count(#Instance.pDataFrame);
             #Data = *Null;
             For #i=1 To #Count By 1;
               #Size = CTLST_ItemSize(#Instance.pDataFrame: #i);
               If (#Data <> *Null);
                 Dealloc #Data;
               EndIf;
               #Data = %Alloc(#Size);
               CTLST_Get(#Instance.pDataFrame: #Data: #Size: #i);
               If #Data <> *Null;

                 #DataSize = #Size;

                 If #Instance.Secure = 1;

                     #Rc = CSAPCORE_SecureWriteRecord(#Instance.pCONN:
                                           #Data:
                                           %Addr(#DataSize):
                                          -1: %Addr(#SSLResult));
                 Else;

                     #Rc = CSAPCORE_WriteRecord(#Instance.pCONN:
                                           #Data:
                                           %Addr(#DataSize):
                                          -1);
                 EndIf;

                 If %bitand(#Rc: CS_MASK_ERROR) = CS_FAILURE;

                   // Failure to send all data
                   #hResult = CSAP_FAILURE;
                   #LastError.Status = '502';
                   #LastError.Reason = CSAP_SEND +
                                       CSAP_USRDATASEGMENT +
                                       #LastError.Reason;
                   Leave;
                 EndIf;
               Else;
                 // Data retrieval failure from local buffer
                 #hResult = CSAP_FAILURE;
                 #LastError.Reason = CSAP_BUFFERERROR;
                 #LastError.Status = '502';
                 #LastError.Reason = CSAP_SEND +
                                     CSAP_USRDATASEGMENT +
                                     CSAP_BUFFERERROR;
                 Leave;
               EndIf;
             EndFor;

             If #Count < #i;
               #hResult = CSAP_SUCCESS;
             Else;
               // Log an error
             EndIf;
           Else;
             // Failure to send all data
             #hResult = CSAP_FAILURE;
             #LastError.Status = '502';
             #LastError.Reason = CSAP_SEND +
                                 CSAP_USRCTLSEGMENT +
                                 #LastError.Reason;
           EndIf;
         Else;
           // Could not send entire control frame
           #hResult = CSAP_FAILURE;
           #LastError.Status = '502';
           #LastError.Reason = CSAP_SEND +
                               CSAP_CTLSEGMENT +
                               #LastError.Reason;
         EndIf;

         #Instance.DataFrameSize = 0;
         CTLST_Clear(#Instance.pDataFrame);

         Return #hResult;

      /End-Free

     P                 E


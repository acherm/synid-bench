     PCTLST_Get        B
     D                 PI            10I 0
     D@This                            *   Value
     D@Value                           *   Value
     D@Bytes                         10I 0
     D@Index                         10I 0 Value

     DNodePtr          S               *
     DRc               S             10I 0
     DHeader           DS                  LikeDs(CTLST_Head) Based(@This)
     DNode             DS                  LikeDs(CTLST_Node) Based(NodePtr)

      /Free

          If (Header.Count = 0);
             @Bytes = -1;
             Return CS_FAILURE;
          EndIf;

          Select;
           When @Index = CTLST_TOP;
            @Index = 1;
           When @Index = CTLST_BOTTOM;
            @Index = Header.Count;
          EndSl;

          If (@Index < 1 Or @Index > Header.Count);
            @Bytes = -1;
            return CS_FAILURE;
          EndIf;

          CTLST_PRIVATE_Goto(@This: @Index);

          Rc = CS_FAILURE;
          If ( Header.Current <> *Null );
             NodePtr = Header.Current;
             If (@Value <> *Null);
               If @Bytes < Node.Bytes;
                 CTLST_PRIVATE_MemCpy(@Value:
                                      Node.Value: @Bytes);
               Else;
                 CTLST_PRIVATE_MemCpy(@Value:
                                      Node.Value: Node.Bytes);
               EndIf;
               @Bytes = Node.Bytes;
             Else;
               @Bytes = 0;
             EndIf;
             Rc = CS_SUCCESS;
          Else;
            @Bytes = -1;
          EndIf;

          Return Rc;

      /End-Free
     P                 E


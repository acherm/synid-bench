       // *************************************************
       // virtual table API -- call PASE script (init)
       // *************************************************
       dcl-proc VirtualCallScript32 export;
         dcl-pi *N IND;
          paseName CHAR(1024) VALUE;
          scriptChunk CHAR(65500) VALUE;
         end-pi;
         DCL-S rcb IND INZ(*ON);
         DCL-S rc INT(10) INZ(0);

         DCL-S fromCCSID INT(10) INZ(0);
         DCL-S toCCSID INT(10) INZ(0);
         DCL-S buffLen INT(10) INZ(0);
         DCL-S outLen INT(10) INZ(0);
         DCL-S buffPtr POINTER INZ(*NULL);
         DCL-S outPtr POINTER INZ(*NULL);

         DCL-S presult INT(5) INZ(QP2_RESULT_VOID);
         DCL-S signature INT(5) INZ(0) dim(2);
         DCL-S ptarget POINTER INZ(*NULL);
         DCL-S psignature POINTER INZ(*NULL);
         DCL-S pbuf POINTER INZ(*NULL);
         DCL-S p64PASE UNS(20) INZ(0);

         DCL-S iData POINTER INZ(*NULL);
         DCL-S pDataStrILE POINTER INZ(*NULL);
         DCL-S pDataMaxILE INT(10) INZ(0);
         DCL-S pDataSizeILE INT(10) INZ(0);

         DCL-S pSize INT(10) INZ(0);
         DCL-S pPtrPASE POINTER INZ(*NULL);
         dcl-ds pArgPASE likeds(virtPase_t) 
                         based(pPtrPASE);

         DCL-S i INT(10) INZ(0);
         DCL-S found IND INZ(*OFF);
         dcl-s iName CHAR(1024) INZ(*BLANKS);
         dcl-s pName CHAR(1024) INZ(*BLANKS);

         dcl-s iPaseCall POINTER INZ(*NULL);

         iName = paseName;
         for i = 1 to VIRT_TABLE_MAX;
           if virtTable(i).iNameLen > %size(iName);
             leave;
           endif;
           pName = *BLANKS;
           pName = %str(virtTable(i).iName:%size(pName));
           if iName = pName;
             found = *ON;
             iPaseCall = virtTable(i).pCall;
             leave;
           endif;
         endfor;
         if found = *OFF;
           return *OFF;
         endif;

         signature(1) = QP2_ARG_PTR32;
         signature(2) = QP2_ARG_END;
         psignature = %addr(signature);

         pDataStrILE = %addr(scriptChunk);
         pDataMaxILE = %size(scriptChunk)+1;
         pDataSizeILE = %len(%trim(scriptChunk));

         pSize = pDataSizeILE * VIRT_CONV_EXPAND + 32;

         // PASE memory
         pPtrPASE = Qp2Malloc(pSize:%addr(p64PASE));
         memset(pPtrPASE:0:pSize);
         // PASE addr to memory
         pArgPASE.pHere = p64PASE + 4;
         // ILE addr (same location)
         iData = pPtrPASE + 4;

         // conversion
         fromCCSID = getIleCCSID();
         toCCSID = PaseLstCCSID();

         buffPtr = pDataStrILE;
         buffLen = pDataSizeILE;
         outPtr = iData;
         outLen = pDataSizeILE * VIRT_CONV_EXPAND;
         rc = convCCSID(fromCCSID:toCCSID:buffPtr:buffLen:outPtr:outLen);
         if rc < 0;
           return *OFF;
         endif;

         // call pase script runner
         ptarget = iPaseCall;
         rc = Qp2CallPase(ptarget:pPtrPASE:psignature:presult:pbuf);
         if rc < 0;
           return *OFF;
         endif;
 
         return *ON;
       end-proc; 

       // *************************************************
       // virtual table API -- PASE lang callback
       // *************************************************
       dcl-proc VirtualCallBack32 export;
         dcl-pi *N IND;
          name POINTER VALUE;
